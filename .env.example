# mock(기본값): 네트워크를 타지 않고 src/mocks의 합성 시나리오로 응답한다.
# api: 아래 EXPO_PUBLIC_API_BASE_URL의 실제 백엔드에 요청한다.
# demo: 예약값, 아직 구현되지 않았다.
EXPO_PUBLIC_APP_MODE=mock

# EXPO_PUBLIC_APP_MODE=api일 때만 실제로 쓰인다(mock 모드는 무시한다).
# 로컬 백엔드 또는 배포된 백엔드 주소를 넣는다.
# 예) 배포 백엔드: https://parity-ai-backend.onrender.com
# 클라이언트 번들에 그대로 포함되니 비밀값은 넣지 않는다.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

EXPO_PUBLIC_DATA_BADGE=true
