{
  "name": "parity-ai-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "prelint": "npm run generate:api-types",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json}\"",
    "pretypecheck": "npm run generate:api-types",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run generate:api-types",
    "test": "jest",
    "generate:api-types": "openapi-typescript docs/api/openapi-1.5.0.json -o src/shared/types/generated/backend.d.ts"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.88.0",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.12",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^9.1.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.8",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  }
}
